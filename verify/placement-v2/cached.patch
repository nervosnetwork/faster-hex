+
+pub(super) fn checked_portable(src: &[u8], dst: &mut [u8], case: CheckCase) -> Result<(), ()> {
+    if !hex_check_fallback_with_case(src, case) {
+        return Err(());
+    }
+    hex_decode_fallback(src, dst);
+    Ok(())
+}
+
+#[cfg(all(target_feature = "sse", not(target_feature = "avx2"), not(miri)))]
+#[inline(always)]
+pub(super) unsafe fn runtime_checked(
+    src: &[u8],
+    dst: &mut [u8],
+    check_case: CheckCase,
+) -> Result<(), ()> {
+    use core::sync::atomic::{AtomicU8, Ordering};
+    type Kernel = unsafe fn(&[u8], &mut [u8], CheckCase) -> Result<(), ()>;
+    static KERNELS: [Kernel; 4] = [
+        checked_portable,
+        hex_decode_sse41_checked,
+        hex_decode_avx2_checked,
+        hex_decode_avx512_checked,
+    ];
+    static NEXT: AtomicU8 = AtomicU8::new(u8::MAX);
+
+    #[cold]
+    fn resolve() -> Kernel {
+        let index: u8 = match crate::vectorization_support() {
+            crate::Vectorization::None => 0,
+            crate::Vectorization::SSE41 => 1,
+            crate::Vectorization::AVX2 => 2,
+            crate::Vectorization::AVX512 => 3,
+        };
+        NEXT.store(index, Ordering::Relaxed);
+        KERNELS[usize::from(index)]
+    }
+    let slot = usize::from(NEXT.load(Ordering::Relaxed));
+    let kernel = KERNELS.get(slot).copied().unwrap_or_else(resolve);
+    // SAFETY: resolve publishes only a kernel supported by the CPU and OS.
+    // The caller established a complete output byte per input pair.
+    unsafe { kernel(src, dst, check_case) }
+}
