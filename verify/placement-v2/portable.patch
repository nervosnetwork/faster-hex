+
+// The portable fallback is compiled separately from the SIMD caller.
+#[inline(never)]
+pub(super) fn checked_portable(src: &[u8], dst: &mut [u8], case: CheckCase) -> Result<(), ()> {
+    if !hex_check_fallback_with_case(src, case) {
